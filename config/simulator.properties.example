# Copia este archivo a config/simulator.properties y ajusta los valores.
# Ninguno de estos valores es un secreto de producción (ver AGENTS.md sección 6).

# Puertos TCP que expone el simulador. minos debe apuntar su configuración de
# SpeiServiceEntity/AraServiceEntity a estos puertos (ver README).
spei.port=6001
ara.port=6002

# Puerto de la API de control HTTP (fuera del protocolo SPEI/ARA) -- health/estado de sesion
# y disparo de abonos de prueba via HTTP, ver httpclient/*.http y README "API de control".
control.port=8089

# Donde se genera/persiste la identidad propia del simulador (llaves RSA + certificado
# autofirmado). Se genera automáticamente la primera vez que se arranca.
identity.dir=data/identity

# Vacío = versionado automático: cada vez que se genera una identidad NUEVA (no cuando se carga
# una ya existente en identity.dir), el número de certificado se genera solo (epoch en segundos,
# 10 dígitos) en vez de reusar un valor fijo. No lo fijes a un número explícito salvo que tengas
# una razón puntual -- un número estático hace que, si regeneras la identidad (borrando los
# archivos de identity.dir), minos siga verificando contra el certificado VIEJO que ya tenía
# cacheado bajo ese mismo número (minos nunca refresca un certificado ya cacheado -- bug real,
# documentado, no corregido -- ver SimulatorIdentity.java y memoria project-banxico-simulador).
# Esto fue justo lo que causó un InvalidKeyException real contra minosc el 2026-09-21.
identity.certificateNumber=

# Certificado publico REAL de la instancia de minos bajo prueba, en PEM (formato
# -----BEGIN CERTIFICATE-----). Es obligatorio para que el reto ARA (IdUsuarioAleat) y el
# desafio ClvSim funcionen -- minos desencripta con su propia llave privada, asi que el
# simulador necesita saber su llave publica de antemano (igual que en la vida real, donde
# Banxico ya tiene registrado el certificado del participante). Ver README "Preparar minos".
minos.publicCert.path=config/minos-public-cert.pem

# Identidad propia (Banxico/simulador) tal como aparece en EnSesion.
own.entityCode=90999
own.entityIndex=1

# Identidad de la entidad de minos bajo prueba, tal como esta configurada en su propia base de
# datos (Spei.entityCode). Debe coincidir exactamente o minos no podra resolver Spei.myEntity.
minos.entityCode=90646
minos.entityIndex=2
minos.entityName=MINOS-DEV

# IMPORTANTE (encontrado 2026-10-05, con Pedro): este NO es un numero de protocolo arbitrario
# tipo "0000000002" -- es el NUMERO DE SERIE X.509 REAL del certificado propio de minos
# (minos-test-identity/minos_test.cer en el host de minos), codificado byte a byte como
# ISO-8859-1 (EnSesionCodec.buildBody -> writeCString). Minos compara este valor, tal cual,
# contra Spei.publicCertificateNumber (que Radamanto le manda como el serial real al
# configurarlo, ver MinosClient.java:448,461 en el repo mki) -- Spei.getMyDefaultCertificateIndex
# (Spei.java:151-158) nunca encuentra coincidencia si aqui se pone un numero inventado, y CUALQUIER
# OrdenTopoV que minos intente armar truena con "Certificate not found". Por eso antes esto traia
# "0000000002" -- es un placeholder que NUNCA funciono para enviar ordenes desde minos, solo paso
# desapercibido porque nada lo habia ejercitado hasta hoy.
#
# Para derivarlo correctamente, de la maquina donde vive el certificado de minos:
#   openssl x509 -in minos_test.cer -noout -serial
#   # ej. serial=43D874C2E9E2B42291627DA911086C1D6623B16F
# y luego convertir esos bytes a escapes \uXXXX de Java properties (cada byte = su codepoint
# Latin-1, uno por uno) -- un one-liner en Python:
#   python3 -c "print(''.join(f'\\\\u{b:04X}' for b in bytes.fromhex('<serial-hex>')))"
# Si minos regenera su identidad (como ya nos paso a nosotros con la nuestra, ver
# identity.certificateNumber arriba), este valor hay que recalcularlo y volver a desplegar --
# no hay forma de que el simulador lo descubra solo, minos no lo reporta por ningun canal.
minos.certificateNumber=0000000002

# Ruta del archivo de base de datos H2 (persistencia de corridas de prueba, Fase 6).
db.path=data/banxicosim

# Usuario que el simulador reporta en LoginMessage/SmLoginReq (no se valida contra nada real).
spei.user=BXCOTEST

# Spec 008: si es true, MsjCatalogos se manda con catalogos sinteticos poblados (institucion,
# tipo de cuenta) en vez del cuerpo vacio de v1. No hay evidencia de que minos reaccione distinto
# -- ver specs/008-msjcatalogos-contenido-real.md "Preguntas abiertas".
catalogos.poblados=false

# Spec 001: valor grande (65535, default) = comportamiento de siempre, sin particion real.
# Bajarlo (ej. 200) fuerza que minos parta de verdad sus propios envios hacia el simulador, y que
# el simulador parta los suyos -- es el mismo valor que EnSesion le declara a minos.
wire.maxMessageLength=65535

# Spec 005 (capa A) -- variaciones de red simulables desde la API de control. Ninguno de estos
# valores es secreto (ver AGENTS.md seccion 6).

# Timeout de lectura real que minos fija en su socket SPEI (SpeiSocketServiceImpl,
# setSoTimeout(6000)) -- solo se usa para calcular red.variacion.retrasoMaximoMs, no cambia
# ningun comportamiento por si solo.
minos.readTimeoutMs=6000

# Intervalo real entre AreYouAlive -- reemplaza el 3s que antes estaba hardcodeado en
# SpeiSession.startHeartbeat().
spei.heartbeatIntervalMs=3000

# Retraso + jitter maximo combinado que puede pedir una variacion de tipo "retraso". Default =
# minos.readTimeoutMs - spei.heartbeatIntervalMs - margen(500) = 6000 - 3000 - 500 = 2500.
red.variacion.retrasoMaximoMs=2500

# Probabilidad maxima (0-1) que puede pedir una variacion de tipo "duplicacion".
red.variacion.duplicacionProbabilidadMaxima=0.5

# Duracion por defecto (segundos) de una variacion de red si no se especifica.
red.variacion.duracionSegundosDefault=60

# Duracion maxima (segundos) de una variacion de red -- ninguna queda indefinida.
red.variacion.duracionSegundosMaxima=900

# Spec 014 -- recepcion y liquidacion de pagos.

# Modo de disparo de Cargos: "inmediato" (1:1 por cada OrdenTopoV con ordenes aceptadas, default)
# o "acumulado" (se junta hasta POST /pagos/cargos/liquidar-lote).
cargos.modoLiquidacion=inmediato

# Saldo inicial de un dia operativo nuevo. Minos no valida este valor contra nada, solo lo
# almacena (Spei.balance / Spei.reservedBalance) y lo reporta a Caina.
cargos.balanceInicial=1000000.00
cargos.reservedBalanceInicial=0.00
